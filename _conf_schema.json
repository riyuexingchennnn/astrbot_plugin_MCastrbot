{
  "server_host": {"type":"string","description":"MC 服务器地址","hint":"域名或 IP，不含端口","default":"127.0.0.1"},
  "server_port": {"type":"int","description":"MC 服务器端口","default":25565},
  "bot_name": {"type":"string","description":"MC 机器人玩家名","default":"Fairy"},
  "mc_version": {"type":"string","description":"MC 协议版本","hint":"留空自动识别协议版本","default":""},
  "mc_auth": {"type":"string","description":"MC 账户认证","default":"offline","options":["offline","microsoft"]},
  "login_password": {"type":"string","description":"登录 Mod 密码","hint":"留空不发送 /login","default":"","secret":true},
  "resting_mode": {"type":"string","description":"登录后游戏模式","hint":"切换模式需要服务器授予 /gamemode 权限；auto/follow 行为会请求 survival 模式","default":"spectator","options":["survival","creative","adventure","spectator"],"labels":["survival","creative","adventure","spectator"]},
  "public_auto_reply": {"type":"bool","description":"回复 MC 公屏消息","hint":"关闭后公屏只记入面板","default":true},
  "wake_keywords": {"type":"list","description":"唤醒词列表","hint":"正文忽略大小写匹配；空列表回复所有消息","default":[]},
  "admin_ids": {"type":"list","description":"管理员玩家名列表","default":[]},
  "allow_admin_llm_actions": {"type":"bool","description":"允许管理员让机器人调用 Agent 工具","default":false},
  "segmented_reply": {"type":"bool","description":"启用 LLM 分段回复","default":true},
  "segmentation": {
    "type":"object",
    "description":"LLM 分段参数",
    "condition":{"segmented_reply":true},
    "items":{
      "split_threshold": {"type":"int","description":"不分段字数阈值","hint":"超过后按此长度分段；单条最多 240 字","default":150},
      "split_mode": {"type":"string","description":"分段模式","default":"regex","options":["regex","length"]},
      "split_regex": {"type":"string","description":"分段正则表达式","hint":"按句末标点或末尾切分","default":".*?[。？！~…\\n]+|.+$","condition":{"split_mode":"regex"}},
      "split_filter_enabled": {"type":"bool","description":"启用内容过滤","default":false},
      "split_filter_regex": {"type":"string","description":"内容过滤正则","hint":"每段发送前移除匹配内容","default":"","condition":{"split_filter_enabled":true}},
      "split_interval_method": {"type":"string","description":"间隔计算方法","default":"fixed","options":["fixed","random","logarithmic"]},
      "split_interval_ms": {"type":"int","description":"发送间隔（毫秒）","default":900},
      "split_log_base": {"type":"float","description":"对数底数","hint":"对数间隔需大于 1","default":1.8,"condition":{"split_interval_method":"logarithmic"}}
    }
  },
  "split_threshold": {"type":"int","description":"旧版分段阈值","default":150,"invisible":true},
  "split_mode": {"type":"string","description":"旧版分段模式","default":"regex","invisible":true},
  "split_regex": {"type":"string","description":"旧版分段正则","default":".*?[。？！~…\\n]+|.+$","invisible":true},
  "split_filter_enabled": {"type":"bool","description":"旧版内容过滤","default":false,"invisible":true},
  "split_filter_regex": {"type":"string","description":"旧版过滤正则","default":"","invisible":true},
  "split_interval_method": {"type":"string","description":"旧版间隔方法","default":"fixed","invisible":true},
  "split_interval_ms": {"type":"int","description":"旧版发送间隔","default":900,"invisible":true},
  "split_log_base": {"type":"float","description":"旧版对数底数","default":1.8,"invisible":true},
  "segmentation_migrated": {"type":"bool","description":"分段配置迁移标记","default":false,"invisible":true},
  "allow_llm_actions": {"type":"bool","description":"允许 LLM 控制机器人行为（总开关）","hint":"仅管理员可调用观察、移动、模式切换、战斗、收集及物品操作等 Agent 工具","default":false}
}
